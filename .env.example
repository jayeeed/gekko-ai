# ========================================
# Gekko AI Interview Coach - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values.
# This file stores sensitive credentials. Do not commit .env to version control.

# ----- Speech-to-Text -----
# Deepgram API key for Speech-to-Text
# Get your key from: https://console.deepgram.com/
DEEPGRAM_API_KEY="your_deepgram_api_key_here"

# ----- AI Providers Setup -----
# Active/Enabled AI providers (comma-separated list)
AI_PROVIDERS="Groq,Cerebras,Gemini,OpenRouter"

# ----- AI Provider: Groq -----
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_SUPPORTS_VISION=true
GROQ_API_KEYS="your_groq_api_key_here"
GROQ_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b,meta-llama/llama-4-scout-17b-16e-instruct,llama-3.1-8b-instant,llama-3.3-70b-versatile"
GROQ_VISION_MODELS="meta-llama/llama-4-scout-17b-16e-instruct"
GROQ_DEFAULT_MODEL="openai/gpt-oss-120b"
GROQ_DEFAULT_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

# ----- AI Provider: Cerebras -----
CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"
CEREBRAS_SUPPORTS_VISION=false
CEREBRAS_API_KEYS="your_cerebras_api_key_here"
CEREBRAS_MODELS="qwen-3-235b-a22b-instruct-2507,llama3.1-8b,zai-glm-4.7,gpt-oss-120b"
CEREBRAS_DEFAULT_MODEL="qwen-3-235b-a22b-instruct-2507"

# ----- AI Provider: Gemini -----
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_SUPPORTS_VISION=true
GEMINI_DEFAULT_SECONDARY=true
GEMINI_DEFAULT_VISION_PRIMARY=true
GEMINI_API_KEYS="your_gemini_api_key_1,your_gemini_api_key_2"
GEMINI_MODELS="gemini-flash-latest,gemini-flash-lite-latest,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it"
GEMINI_VISION_MODELS="gemini-flash-latest,gemini-flash-lite-latest,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it"
GEMINI_DEFAULT_MODEL="gemini-3-flash-preview"
GEMINI_DEFAULT_VISION_MODEL="gemini-3-flash-preview"

# ----- AI Provider: OpenRouter -----
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_SUPPORTS_VISION=true
OPENROUTER_DEFAULT_PRIMARY=true
OPENROUTER_DEFAULT_VISION_SECONDARY=true
OPENROUTER_API_KEYS="your_openrouter_api_key_here"
OPENROUTER_MODELS="openai/gpt-4o-mini,openai/gpt-5-mini,google/gemini-3-flash-preview,google/gemini-3.1-flash-lite-preview,google/gemini-3.1-pro-preview,minimax/minimax-m2.7,x-ai/grok-4.1-fast,openai/gpt-5.4-nano,z-ai/glm-5"
OPENROUTER_VISION_MODELS="openai/gpt-4o-mini,openai/gpt-5-mini,google/gemini-3-flash-preview,google/gemini-3.1-flash-lite-preview,google/gemini-3.1-pro-preview,minimax/minimax-m2.7,x-ai/grok-4.1-fast,openai/gpt-5.4-nano,z-ai/glm-5"
OPENROUTER_DEFAULT_MODEL="openai/gpt-4o-mini"
OPENROUTER_DEFAULT_VISION_MODEL="openai/gpt-5-mini"

# ----- Logging -----
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ----- Development Mode -----
# Controls debugging features across Python and JavaScript
# Set to true to enable verbose console logging and dev shortcuts
DEV_MODE=false

# ----- AI Behaviour -----
TRACK_CANDIDATE_RESPONSES=true
INCLUDE_CONVERSATION_HISTORY=true
MAX_CONVERSATION_HISTORY=6
GENERATE_FULL_ANSWERS=true
PERSONALIZE_ANSWERS=true

# ----- Stealth / Proctoring -----
# Enable system tray functionality
ENABLE_SYSTEM_TRAY=false
# Start hidden in system tray (set to true for maximum stealth)
START_IN_STEALTH_MODE=true

# ----- Scroll Speed (Alt+Up/Down) -----
# Pixels per scroll tick — higher = faster scroll
# Examples: 100 = slow, 200 = medium (default), 400 = fast
SCROLL_SPEED_PX=200
# Milliseconds between scroll ticks while key is held — lower = smoother/faster
# Examples: 30 = fast, 50 = default, 80 = slow
SCROLL_INTERVAL_MS=50
